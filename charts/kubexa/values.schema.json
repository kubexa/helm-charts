{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preflight": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "pvcTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "pvcProbeSize": { "type": "string" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "rbac": {
          "type": "object",
          "properties": { "create": { "type": "boolean" } }
        },
        "serviceAccount": {
          "type": "object",
          "properties": { "name": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceName": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "password": { "type": "string" },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": "string" },
            "size": { "type": "string" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceName": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "superuserPassword": { "type": "string" },
        "appPassword": { "type": "string" },
        "usersPassword": { "type": "string" },
        "appDatabase": { "type": "string", "minLength": 1 },
        "usersDatabase": { "type": "string", "minLength": 1 },
        "appUser": { "type": "string", "minLength": 1 },
        "usersUser": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": "string" },
            "size": { "type": "string" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "victoriaMetrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "server": { "type": "object" }
      }
    },
    "loki": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "fullnameOverride": { "type": "string", "minLength": 1 },
        "loki": { "type": "object" }
      }
    },
    "apiserver": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
